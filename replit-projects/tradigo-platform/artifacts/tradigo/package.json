{
  "name": "@workspace/tradigo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:browser:install": "playwright install chromium firefox webkit",
    "test:browser:install:chromium": "playwright install chromium",
    "test:browser": "pnpm run test:browser:install && PLAYWRIGHT_OUTPUT_DIR=test-results/all playwright test --config playwright.config.ts",
    "test:browser:authenticated": "pnpm run test:browser:install && PLAYWRIGHT_OUTPUT_DIR=test-results/authenticated playwright test --config playwright.config.ts --project=chromium --project=firefox-text-enlargement --project=firefox-text-enlargement-tablet --project=firefox-text-enlargement-desktop --project=webkit-text-enlargement --project=webkit-text-enlargement-tablet --project=webkit-text-enlargement-desktop --project=firefox-marketplace-refresh --project=webkit-marketplace-refresh e2e/text-enlargement.spec.ts e2e/marketplace-refresh-announcements.spec.ts",
    "test:browser:drawer": "pnpm run test:browser:install && PLAYWRIGHT_OUTPUT_DIR=test-results/drawer PLAYWRIGHT_TEST_PORT=5174 playwright test --config playwright.config.ts --project=chromium --project=firefox-mobile-drawer --project=webkit-mobile-drawer e2e/mobile-drawer-accessibility.spec.ts",
    "test:a11y": "vitest run --config vitest.config.ts src/routes/shared/SessionsListView.test.tsx src/routes/shared/SessionJourneyView.test.tsx --reporter=verbose"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
