# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/generated-artifacts/

# Keep the Expo build output in the deployment image; the production server
# reads its manifests and assets from this directory at startup.
# Staging output is temporary and should not be packaged.
artifacts/tradify-signals/.static-build.stage-*
